{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventflow_db;Username=postgres;Password=postgres;"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "eventflow.events",
    "QueueName": "eventflow.events.processing",
    "RoutingKeyPattern": "#",
    "PrefetchCount": 10,
    "ClientProvidedName": "eventflow-worker",
    "RequestedHeartbeatSeconds": 60
  },
  "OutboxProcessor": {
    "BatchSize": 50,
    "PollingIntervalMs": 1000,
    "MaxRetries": 5,
    "BaseRetryDelaySeconds": 2
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "eventflow:",
    "LockTtlSeconds": 30,
    "CacheTtlHours": 24,
    "Enabled": true
  }
}
