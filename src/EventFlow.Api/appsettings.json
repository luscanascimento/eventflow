{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventflow_db;Username=postgres;Password=postgres;"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "eventflow.events",
    "ClientProvidedName": "eventflow-api",
    "RequestedHeartbeatSeconds": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "eventflow:",
    "LockTtlSeconds": 30,
    "CacheTtlHours": 24,
    "Enabled": true
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 1.0,
    "MaxDelaySeconds": 10.0,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerSamplingDurationSeconds": 30.0,
    "CircuitBreakerBreakDurationSeconds": 15.0,
    "AttemptTimeoutSeconds": 5.0,
    "TotalTimeoutSeconds": 20.0
  }
}
