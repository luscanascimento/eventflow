{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventflow_db;Username=postgres;Password=postgres;"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "eventflow.events",
    "ClientProvidedName": "eventflow-api",
    "RequestedHeartbeatSeconds": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "eventflow:",
    "LockTtlSeconds": 30,
    "CacheTtlHours": 24,
    "Enabled": true
  }
}
