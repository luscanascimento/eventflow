# ==============================================================================
# EventFlow Environment Configuration Example
# Copy this file to '.env' and adjust values for your local or production deployment.
# ==============================================================================

# PostgreSQL Persistence
POSTGRES_DB=eventflow
POSTGRES_USER=eventflow_user
POSTGRES_PASSWORD=eventflow_secret_password
POSTGRES_PORT=5432

# RabbitMQ Message Broker
RABBITMQ_USER=eventflow_admin
RABBITMQ_PASSWORD=eventflow_admin_secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis Idempotency Fast-Guard & Distributed Lock
REDIS_PORT=6379

# EventFlow API & Worker Runtime
API_PORT=8080
API_KEY=ef_live_secret_key_1234567890abcdef

# OpenTelemetry & Distributed Tracing (Jaeger / OpenTelemetry Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
